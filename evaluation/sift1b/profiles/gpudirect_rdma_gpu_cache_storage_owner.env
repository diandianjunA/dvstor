PROFILE_NAME=gpudirect_rdma_gpu_cache_storage_owner
CONFIG_FILE="$SCRIPT_DIR/configs/gpudirect_rdma_gpu_cache_storage_owner.ini"
GPUDIRECT_RDMA=1
COMPUTE_CACHE=0
if [[ "${GPU_NODE_CACHE_MB_WAS_DEFAULT:-0}" == "1" ]]; then GPU_NODE_CACHE_MB=4096; fi
INSERT_EXECUTION=storage_owner
STORAGE_OWNER_CACHE_MB="${STORAGE_OWNER_CACHE_MB:-4096}"
