PROFILE_NAME=gpudirect_rdma_storage_owner_rabitq
CONFIG_FILE="$SCRIPT_DIR/configs/gpudirect_rdma_storage_owner.ini"
GPUDIRECT_RDMA=1
INSERT_EXECUTION=storage_owner
EXPANSION_BATCH=1
RDMA_QP_POOL_SIZE=1
QUERY_BATCH_SIZE=1
USE_RABITQ=1
RABITQ_CONFIDENCE_EPSILON="${RABITQ_CONFIDENCE_EPSILON:-1.9}"
RABITQ_EXACT_BATCH="${RABITQ_EXACT_BATCH:-64}"
RABITQ_EXACT_BUDGET="${RABITQ_EXACT_BUDGET:-256}"
MIN_RECALL=0.85
