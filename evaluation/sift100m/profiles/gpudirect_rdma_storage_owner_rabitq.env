PROFILE_NAME=gpudirect_rdma_storage_owner_rabitq
CONFIG_FILE="$SCRIPT_DIR/configs/gpudirect_rdma_storage_owner.ini"
GPUDIRECT_RDMA=1
INSERT_EXECUTION=storage_owner
EXPANSION_BATCH=1
RDMA_QP_POOL_SIZE=1
QUERY_BATCH_SIZE="${QUERY_BATCH_SIZE:-1}"
USE_RABITQ=1
RABITQ_MODE="${RABITQ_MODE:-gpu_coalesced}"
RABITQ_GATE_WIDTH="${RABITQ_GATE_WIDTH:-16}"
RABITQ_GATE_MAX_WIDTH="${RABITQ_GATE_MAX_WIDTH:-32}"
RABITQ_GATE_MARGIN="${RABITQ_GATE_MARGIN:-0.08}"
RABITQ_CACHE_MAX_RATIO="${RABITQ_CACHE_MAX_RATIO:-0.10}"
RABITQ_DYNAMIC_BUDGET_MB="${RABITQ_DYNAMIC_BUDGET_MB:-64}"
RABITQ_COALESCE_TARGET="${RABITQ_COALESCE_TARGET:-64}"
RABITQ_COALESCE_MIN="${RABITQ_COALESCE_MIN:-32}"
RABITQ_COALESCE_WAIT_US="${RABITQ_COALESCE_WAIT_US:-6}"
RABITQ_STRICT_RECALL="${RABITQ_STRICT_RECALL:-1}"
MIN_RECALL=0.8823
