PROFILE_NAME=gpudirect_rdma_storage_owner_rabitq
CONFIG_FILE="$SCRIPT_DIR/configs/gpudirect_rdma_storage_owner.ini"
GPUDIRECT_RDMA=1
INSERT_EXECUTION=storage_owner
EXPANSION_BATCH=1
RDMA_QP_POOL_SIZE=1
QUERY_BATCH_SIZE=1
USE_RABITQ=1
RABITQ_GATE_WIDTH="${RABITQ_GATE_WIDTH:-16}"
RABITQ_GATE_MAX_WIDTH="${RABITQ_GATE_MAX_WIDTH:-24}"
RABITQ_GATE_MARGIN="${RABITQ_GATE_MARGIN:-0.05}"
RABITQ_CACHE_MAX_RATIO="${RABITQ_CACHE_MAX_RATIO:-0.15}"
MIN_RECALL=0.85
