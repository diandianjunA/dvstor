# GPUDirect RDMA plus slot_clock GPU RaBitQ cache and storage_owner inserts.
PROFILE_NAME=gpudirect_slot_clock_storage_owner
INSERT_EXECUTION=storage_owner
INSERT_WORKERS=0
QUERY_WORKERS=16
GPUDIRECT_RDMA=true
GPU_RABITQ_CACHE_MB=8192
RABITQ_CACHE_MODE=slot_clock
NEIGHBOR_CACHE_MB=2048
STORAGE_OWNER_CACHE_MB=1024

