# GPUDirect RDMA plus GPU RaBitQ cache using gentile replacement.
PROFILE_NAME=gpudirect_gentile
INSERT_EXECUTION=compute
GPUDIRECT_RDMA=true
GPU_RABITQ_CACHE_MB=8192
RABITQ_CACHE_MODE=gentile
GENTILE_TILE_SLOTS=32
GENTILE_NURSERY_RATIO=0.25
GENTILE_PROMOTION_THRESHOLD=2
GENTILE_ENABLE_PROMOTION=false
GENTILE_ENABLE_VALUE_BIN=false
GENTILE_ENABLE_HIT_TILE_GROUPING=true
NEIGHBOR_CACHE_MB=2048
STORAGE_OWNER_CACHE_MB=0

