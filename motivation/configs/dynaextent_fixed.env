# Dynamic mixed-workload triplet: full-record baseline.  Keep every value
# except the two graph-read policy controls identical across the three files.
ENABLE_UPDATES=true
GPU_QUERY_GRAPH_READ_POLICY=fixed
GPU_DYNAMIC_GRAPH_EXTENT=false
GPU_GRAPH_PREFETCH_DEPTH=16
GPU_QUERY_BEAM_MERGE_POLICY=stable-run
QUERY_RDMA_TRACE_MODE=off
