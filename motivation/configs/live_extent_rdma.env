# Reproducible matrix for the Live-Extent RDMA motivation probe.
#
# Usage:
#   LIVE_EXTENT_CONFIG=motivation/configs/live_extent_rdma.env \
#     ./motivation/run_live_extent_rdma_probe.sh

PROFILE=04_gpu_persistent_gpunetio

# The storage nodes are normally managed on a remote host, so no compute-node
# PID file exists. This skips only that local PID check; connection failures
# still fail the probe.
SKIP_STORAGE_PID_CHECK=1

GPU_RDMA_QPS=32
LIVE_EXTENT_ACTIVE_QPS_LIST=1,8,32,160
LIVE_EXTENT_PAYLOAD_BYTES=16,80,144,272,400,448,528,832
LIVE_EXTENT_PAIRED_BODY_BYTES=400,448
LIVE_EXTENT_BATCH_READS=16
LIVE_EXTENT_WARMUP_ITERATIONS=32
LIVE_EXTENT_ITERATIONS=512
LIVE_EXTENT_REPEATS=3
LIVE_EXTENT_REMOTE_SPAN_BYTES=67108864
