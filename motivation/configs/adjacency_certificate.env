# Observation-only configuration for certified remote-adjacency transfer.
# The search path remains the fixed-depth C16 stable-run baseline. Enabling the
# existing sampled trace switch activates the read-only perfect/geometry oracle.
GPU_QUERY_EXPANSION_POLICY=fixed
GPU_QUERY_BEAM_MERGE_POLICY=stable-run
GPU_GRAPH_PREFETCH_DEPTH=16
QUERY_RDMA_TRACE_MODE=sampled
QUERY_RDMA_TRACE_EVENTS_PER_QUERY=128
RECALL_QUERIES=100
MIN_RECALL=-1
MIN_QUERY_QPS=-1
MIN_STABILITY_RATIO=-1
