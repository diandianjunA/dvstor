# End-to-end Live-Extent A/B baseline. Keep every search-semantic parameter
# identical to the enabled case; only the graph-record transfer policy changes.
ENABLE_UPDATES=false
GPU_QUERY_GRAPH_READ_POLICY=fixed
GPU_GRAPH_PREFETCH_DEPTH=16
GPU_QUERY_BEAM_MERGE_POLICY=stable-run
QUERY_RDMA_TRACE_MODE=off
