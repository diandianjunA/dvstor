# One-sided, one-WQE Live-Extent graph-record reads. The implementation derives
# the extent sidecar from INDEX_PREFIX and must fail startup if it is absent or
# incompatible; this experiment must never silently become the fixed baseline.
ENABLE_UPDATES=false
GPU_DYNAMIC_GRAPH_ACCESS_MODE=manual
GPU_QUERY_GRAPH_READ_POLICY=live-extent
GPU_DYNAMIC_GRAPH_EXTENT=true
GPU_GRAPH_PREFETCH_DEPTH=16
GPU_QUERY_BEAM_MERGE_POLICY=stable-run
QUERY_RDMA_TRACE_MODE=off
