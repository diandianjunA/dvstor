# Dynamic mixed-workload triplet: static-node Live-Extent only.  Dynamic graph
# records deliberately retain full-record reads.
ENABLE_UPDATES=true
GPU_DYNAMIC_GRAPH_ACCESS_MODE=manual
GPU_QUERY_GRAPH_READ_POLICY=live-extent
GPU_DYNAMIC_GRAPH_EXTENT=false
GPU_GRAPH_PREFETCH_DEPTH=16
GPU_QUERY_BEAM_MERGE_POLICY=stable-run
QUERY_RDMA_TRACE_MODE=off
