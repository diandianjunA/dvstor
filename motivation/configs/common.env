# Controlled query-only motivation experiment defaults.
WORKLOAD="${WORKLOAD:-query}"
ENABLE_UPDATES="${ENABLE_UPDATES:-false}"
WARMUP_SECONDS="${WARMUP_SECONDS:-30}"
MEASURE_SECONDS="${MEASURE_SECONDS:-120}"
RECALL_QUERIES="${RECALL_QUERIES:-1000}"
RECALL_K="${RECALL_K:-10}"
RECALL_MODE="${RECALL_MODE:-all}"
QUERY_RDMA_TRACE_MODE="${QUERY_RDMA_TRACE_MODE:-off}"
QUERY_RDMA_TRACE_SAMPLE_RATE="${QUERY_RDMA_TRACE_SAMPLE_RATE:-1000}"
QUERY_RDMA_TRACE_EVENTS_PER_QUERY="${QUERY_RDMA_TRACE_EVENTS_PER_QUERY:-1024}"
GPU_QUERY_EXPANSION_POLICY="${GPU_QUERY_EXPANSION_POLICY:-fixed}"
GPU_QUERY_BEAM_MERGE_POLICY="${GPU_QUERY_BEAM_MERGE_POLICY:-stable-run}"
