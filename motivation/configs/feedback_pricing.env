# Fixed-C16 observation run for Beam-turnover and productive-suffix analysis.
# The expensive diagnostic kernel is sampled and never changes search state.
GPU_QUERY_EXPANSION_POLICY=fixed
GPU_QUERY_BEAM_MERGE_POLICY=stable-run
GPU_GRAPH_PREFETCH_DEPTH=16
QUERY_RDMA_TRACE_MODE=sampled
QUERY_RDMA_TRACE_EVENTS_PER_QUERY=32
RECALL_QUERIES=100
MIN_RECALL=-1
MIN_QUERY_QPS=-1
MIN_STABILITY_RATIO=-1
