#!/usr/bin/env bash

# Shared defaults for the GPU-direct pipeline motivation experiments.
# Every value can be overridden from the environment.

WARMUP_SECONDS="${WARMUP_SECONDS:-10}"
MEASURE_SECONDS="${MEASURE_SECONDS:-60}"
RECALL_QUERIES="${RECALL_QUERIES:-1000}"
MIN_RECALL="${MIN_RECALL:--1}"

# Use one service worker so the concurrency sweep isolates coroutine-level
# overlap instead of scaling CPU worker threads.
SERVICE_THREADS="${SERVICE_THREADS:-1}"
QUERY_WORKERS="${QUERY_WORKERS:-1}"
INSERT_WORKERS="${INSERT_WORKERS:-0}"
INSERT_EXECUTION="${INSERT_EXECUTION:-compute}"

WORKLOAD="${WORKLOAD:-query}"
QUERY_BATCH_SIZE="${QUERY_BATCH_SIZE:-1}"
USE_RABITQ="${USE_RABITQ:-0}"

# Optional system-level sampling. Set to 1 to collect nvidia-smi dmon output.
ENABLE_DEVICE_SAMPLING="${ENABLE_DEVICE_SAMPLING:-0}"

