#!/usr/bin/env bash

# Naive disaggregated GPU graph search: one query at a time, host staging,
# one graph expansion per iteration, and no approximate gate.
GPUDIRECT_RDMA=0
COROUTINES="${MOTIVATION_COROUTINES:-1}"
QUERY_COROUTINES="${MOTIVATION_QUERY_COROUTINES:-$COROUTINES}"
CLIENT_THREADS="${MOTIVATION_CLIENT_THREADS:-1}"
EXPANSION_BATCH="${MOTIVATION_EXPANSION_BATCH:-1}"
QUERY_BATCH_SIZE=1
USE_RABITQ=0
RDMA_QP_POOL_SIZE="${MOTIVATION_RDMA_QP_POOL_SIZE:-1}"
RDMA_READ_BATCH_MODE="${MOTIVATION_RDMA_READ_BATCH_MODE:-adaptive}"
