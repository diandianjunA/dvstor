#!/usr/bin/env bash

# DEEP100M-only balanced -> METIS conversion defaults. Every value may be
# overridden in the environment without editing this file.
SOURCE_INDEX_PREFIX="${SOURCE_INDEX_PREFIX:-/data/xjs/index/dvstor_deep100m/index/deep100m_R96_bw128_balanced_pmd32_pq32_schema16}"
METIS_INDEX_PREFIX="${METIS_INDEX_PREFIX:-/data/xjs/index/dvstor_deep100m/index/deep100m_R96_bw128_metis_pmd32_pq32_schema16}"
REPARTITION_DATA_PATH="${REPARTITION_DATA_PATH:-/data/xjs/datasets/deep1b/deep100m/100M.fbin}"

PARTITION_MAX_DEGREE="${PARTITION_MAX_DEGREE:-32}"
PARTITION_IMBALANCE="${PARTITION_IMBALANCE:-1.03}"
REPARTITION_THREADS="${REPARTITION_THREADS:-16}"
PQ_CHUNK_VECTORS="${PQ_CHUNK_VECTORS:-32768}"
BUILD_JOBS="${BUILD_JOBS:-16}"

RUN_REPARTITIONER_TESTS="${RUN_REPARTITIONER_TESTS:-1}"
GRAPH_ONLY="${GRAPH_ONLY:-0}"
VALIDATE_ONLY="${VALIDATE_ONLY:-0}"
# Destructive cleanup is deliberately opt-in. It runs only after the converter
# has fully validated the independently committed schema-16 METIS output.
DELETE_BALANCED_AFTER_SUCCESS="${DELETE_BALANCED_AFTER_SUCCESS:-0}"

