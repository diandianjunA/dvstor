# Baseline system: the same schema-16 index, GPU resources, RDMA resources,
# and storage-owner update offload as full, with the three proposed mechanisms
# disabled at their contribution boundaries.  In particular, coupled update
# is one synchronous logical-owner operation that ACKs a fresh insert only
# after global search/prune, the local stable write and centroid publication,
# and all one-sided-RDMA backlinks; it has no Stage1/Stage2 backlog.

SYSTEM_VARIANT_LABEL=baseline
STORAGE_OWNER_UPDATE_COMPLETION_MODE="${STORAGE_OWNER_UPDATE_COMPLETION_MODE:-coupled}"
GPU_DYNAMIC_GRAPH_ACCESS_MODE="${GPU_DYNAMIC_GRAPH_ACCESS_MODE:-fixed}"
GPU_RDMA_SEARCH_PROGRESSION_MODE="${GPU_RDMA_SEARCH_PROGRESSION_MODE:-coupled}"

source "$EXPERIMENT_DIR/profiles/04_gpu_persistent_gpunetio_common.sh"
