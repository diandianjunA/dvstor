# GPU-centric query engine: persistent CUDA scheduler + RaBitQ + GPU-initiated RDMA.
PROFILE_NAME=04_gpu_persistent_gpunetio
CONTRIBUTION_STAGE=gpu_persistent_gpunetio

GPU_TIERED_INDEX=1
SEARCH_ENGINE=gpu_persistent
GPU_RDMA_BACKEND="${GPU_RDMA_BACKEND:-gpunetio}"
GPUDIRECT_RDMA=1
INSERT_EXECUTION=storage_owner
USE_RABITQ=1

GPU_QUERY_BATCH_MIN="${GPU_QUERY_BATCH_MIN:-8}"
GPU_QUERY_BATCH_TARGET="${GPU_QUERY_BATCH_TARGET:-64}"
GPU_QUERY_BATCH_MAX="${GPU_QUERY_BATCH_MAX:-256}"
GPU_QUERY_BATCH_WAIT_US="${GPU_QUERY_BATCH_WAIT_US:-20}"
GPU_HOT_DEGREE="${GPU_HOT_DEGREE:-32}"
GPU_ENTRY_POINTS="${GPU_ENTRY_POINTS:-256}"
GPU_COLD_EXPANSIONS="${GPU_COLD_EXPANSIONS:-8}"
GPU_GRAPH_PAGE_BYTES="${GPU_GRAPH_PAGE_BYTES:-4096}"
GPU_PAGE_CACHE_MB="${GPU_PAGE_CACHE_MB:-8192}"
GPU_RDMA_QPS="${GPU_RDMA_QPS:-8}"
GPU_PERSISTENT_BLOCKS_PER_SM="${GPU_PERSISTENT_BLOCKS_PER_SM:-4}"
GPU_DELTA_SIGNATURE_FILTER="${GPU_DELTA_SIGNATURE_FILTER:-0}"

SEARCH_BEAM="${GPU_PERSISTENT_SEARCH_BEAM:-64}"
RABITQ_GATE_WIDTH="${RABITQ_GATE_WIDTH:-32}"
RABITQ_GATE_MAX_WIDTH="${RABITQ_GATE_MAX_WIDTH:-64}"
RABITQ_GATE_MARGIN="${RABITQ_GATE_MARGIN:-0.08}"

UPDATE_VISIBILITY_US="${UPDATE_VISIBILITY_US:-10000}"
DELTA_MAX_RATIO="${DELTA_MAX_RATIO:-0.01}"
DELTA_BUDGET_MB="${DELTA_BUDGET_MB:-2048}"
MERGE_PERIOD_MS="${MERGE_PERIOD_MS:-60000}"

STORAGE_OWNER_UPDATE_MODE="${STORAGE_OWNER_UPDATE_MODE:-local_stitch}"
STORAGE_OWNER_ANCHOR_HINTS="${STORAGE_OWNER_ANCHOR_HINTS:-4}"
STORAGE_OWNER_ANCHOR_BEAM_WIDTH="${STORAGE_OWNER_ANCHOR_BEAM_WIDTH:-64}"
STORAGE_OWNER_ANCHOR_EXPAND_CAP="${STORAGE_OWNER_ANCHOR_EXPAND_CAP:-16}"
STORAGE_OWNER_ANCHOR_REMOTE_RESCUE_CAP="${STORAGE_OWNER_ANCHOR_REMOTE_RESCUE_CAP:-4}"
STORAGE_OWNER_LOCAL_STITCH_SYNC_FAST_PATH="${STORAGE_OWNER_LOCAL_STITCH_SYNC_FAST_PATH:-1}"
STORAGE_OWNER_MAINTENANCE_MODE="${STORAGE_OWNER_MAINTENANCE_MODE:-finalize}"
STORAGE_OWNER_MAINTENANCE_WORKERS="${STORAGE_OWNER_MAINTENANCE_WORKERS:-8}"

PARTITION_STRATEGY=metis
INDEX_PREFIX="${METIS_INDEX_PREFIX:-$INDEX_DIR/sift100m_R${R}_bw${BUILD_BEAM}_metis_pmd32}"
MIN_RECALL="${MIN_RECALL:--1}"
ENABLE_BREAKDOWN=1
OBSERVE_DEVICE_UTILIZATION=0
