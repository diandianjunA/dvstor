# Single supported runtime: persistent GPU OPQ/PQ graph navigation over GPUNetIO.
PROFILE_NAME=04_gpu_persistent_gpunetio

PARTITION_STRATEGY=metis
LEGACY_INDEX_PREFIX="${LEGACY_INDEX_PREFIX:-$INDEX_DIR/sift100m_R${R}_bw${BUILD_BEAM}_metis_pmd32}"
PQ_SUBQUANTIZERS="${PQ_SUBQUANTIZERS:-32}"
INDEX_PREFIX="${PQ_INDEX_PREFIX:-$INDEX_DIR/sift100m_R${R}_bw${BUILD_BEAM}_metis_pmd32_pq${PQ_SUBQUANTIZERS}}"

SERVICE_THREADS="${GPU_SERVICE_THREADS:-64}"
CLIENT_THREADS="${GPU_CLIENT_THREADS:-128}"
GPU_QUERY_BATCH_MIN="${GPU_QUERY_BATCH_MIN:-8}"
GPU_QUERY_BATCH_TARGET="${GPU_QUERY_BATCH_TARGET:-64}"
GPU_QUERY_BATCH_MAX="${GPU_QUERY_BATCH_MAX:-256}"
GPU_QUERY_BATCH_WAIT_US="${GPU_QUERY_BATCH_WAIT_US:-10}"
GPU_MEMORY_LIMIT_GB="${GPU_MEMORY_LIMIT_GB:-40}"
GPU_MEMORY_RESERVE_GB="${GPU_MEMORY_RESERVE_GB:-4}"
GPU_ADJACENCY_CACHE_MB="${GPU_ADJACENCY_CACHE_MB:-3072}"
GPU_ADJACENCY_CACHE_WAYS=4
GPU_EXACT_CACHE_MB="${GPU_EXACT_CACHE_MB:-4096}"
GPU_EXACT_CACHE_WAYS=4
GPU_BOOTSTRAP_WINDOW_MB="${GPU_BOOTSTRAP_WINDOW_MB:-64}"
GPU_BOOTSTRAP_WINDOWS="${GPU_BOOTSTRAP_WINDOWS:-4}"
GPU_GRAPH_PREFETCH_DEPTH="${GPU_GRAPH_PREFETCH_DEPTH:-8}"
GPU_GRAPH_CACHE_TTL_US="${GPU_GRAPH_CACHE_TTL_US:-0}"
GPU_TRAVERSAL_BEAM_WIDTH="${GPU_TRAVERSAL_BEAM_WIDTH:-128}"
GPU_FINAL_RERANK_WIDTH="${GPU_FINAL_RERANK_WIDTH:-128}"
GPU_MAX_EXPANSIONS="${GPU_MAX_EXPANSIONS:-384}"
GPU_ENTRY_SEED_COUNT="${GPU_ENTRY_SEED_COUNT:-32}"
GPU_DELTA_ANCHOR_PROBES="${GPU_DELTA_ANCHOR_PROBES:-32}"
GPU_RDMA_QPS="${GPU_RDMA_QPS:-16}"
GPU_PERSISTENT_BLOCKS_PER_SM="${GPU_PERSISTENT_BLOCKS_PER_SM:-2}"

PQ_TRAIN_SAMPLES="${PQ_TRAIN_SAMPLES:-262144}"
PQ_OPQ_ITERATIONS="${PQ_OPQ_ITERATIONS:-20}"
PQ_ITERATIONS="${PQ_ITERATIONS:-25}"
PQ_ENCODE_CHUNK_VECTORS="${PQ_ENCODE_CHUNK_VECTORS:-32768}"
PQ_THREADS="${PQ_THREADS:-32}"
GPU_ENTRY_POINTS="${GPU_ENTRY_POINTS:-256}"

UPDATE_VISIBILITY_US="${UPDATE_VISIBILITY_US:-10000}"
DELTA_MAX_RATIO="${DELTA_MAX_RATIO:-0.01}"
DELTA_BUDGET_MB="${DELTA_BUDGET_MB:-2048}"
MERGE_PERIOD_MS="${MERGE_PERIOD_MS:-60000}"

STORAGE_OWNER_COROUTINES="${STORAGE_OWNER_COROUTINES:-4}"
STORAGE_OWNER_BATCH_MAX="${STORAGE_OWNER_BATCH_MAX:-32}"
STORAGE_OWNER_BATCH_WAIT_US="${STORAGE_OWNER_BATCH_WAIT_US:-100}"
STORAGE_OWNER_RPC_DEPTH="${STORAGE_OWNER_RPC_DEPTH:-16}"
STORAGE_OWNER_UPDATE_MODE="${STORAGE_OWNER_UPDATE_MODE:-local_stitch}"
STORAGE_OWNER_ANCHOR_HINTS="${STORAGE_OWNER_ANCHOR_HINTS:-4}"
STORAGE_OWNER_ANCHOR_BEAM_WIDTH="${STORAGE_OWNER_ANCHOR_BEAM_WIDTH:-64}"
STORAGE_OWNER_ANCHOR_EXPAND_CAP="${STORAGE_OWNER_ANCHOR_EXPAND_CAP:-16}"
STORAGE_OWNER_ANCHOR_REMOTE_RESCUE_CAP="${STORAGE_OWNER_ANCHOR_REMOTE_RESCUE_CAP:-4}"
STORAGE_OWNER_LOCAL_STITCH_SYNC_FAST_PATH="${STORAGE_OWNER_LOCAL_STITCH_SYNC_FAST_PATH:-false}"
STORAGE_OWNER_MAINTENANCE_MODE="${STORAGE_OWNER_MAINTENANCE_MODE:-finalize}"
STORAGE_OWNER_MAINTENANCE_WORKERS="${STORAGE_OWNER_MAINTENANCE_WORKERS:-8}"

MIN_RECALL="${MIN_RECALL:--1}"
ENABLE_BREAKDOWN="${ENABLE_BREAKDOWN:-true}"
