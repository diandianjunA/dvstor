# Motivation experiment: make the per-query serial RDMA/GPU dependency visible.
# This is an instrumented, query-only profile; it is not for final QPS or p95
# numbers.  One query worker and one coroutine ensure that no cross-query work
# hides the remote wait of strict best-first traversal.
PROFILE_NAME=motivation_serial_pipeline_16_rabitq
CONTRIBUTION_STAGE=motivation_serial_pipeline_16_rabitq

WORKLOAD=query
CLIENT_THREADS=1
SERVICE_THREADS=1
COROUTINES=1
QUERY_WORKERS=1
QUERY_COROUTINES=1
INSERT_WORKERS=0
INSERT_COROUTINES=0

GPUDIRECT_RDMA=1
INSERT_EXECUTION=storage_owner
EXPANSION_BATCH=16
QUERY_BATCH_SIZE=1
RDMA_QP_POOL_SIZE=1
RDMA_READ_BATCH_MODE=legacy
RDMA_READ_CHAIN_SIZE=0
RDMA_READ_MAX_INFLIGHT_WRS=0

USE_RABITQ=1
RABITQ_GATE_WIDTH="${RABITQ_GATE_WIDTH:-18}"
RABITQ_GATE_MAX_WIDTH="${RABITQ_GATE_MAX_WIDTH:-36}"
RABITQ_GATE_MARGIN="${RABITQ_GATE_MARGIN:-0.08}"
RABITQ_CACHE_MAX_RATIO="${RABITQ_CACHE_MAX_RATIO:-0.10}"
RABITQ_DYNAMIC_BUDGET_MB="${RABITQ_DYNAMIC_BUDGET_MB:-64}"
RABITQ_COALESCE_TARGET="${RABITQ_COALESCE_TARGET:-64}"
RABITQ_COALESCE_MIN="${RABITQ_COALESCE_MIN:-32}"
RABITQ_COALESCE_WAIT_US="${RABITQ_COALESCE_WAIT_US:-6}"
RABITQ_WARMUP_EXACT_EXPANSIONS="${RABITQ_WARMUP_EXACT_EXPANSIONS:-6}"
RABITQ_AUDIT_PERIOD="${RABITQ_AUDIT_PERIOD:-12}"
RABITQ_STRICT_RECALL="${RABITQ_STRICT_RECALL:-1}"

# Emit per-request phase breakdown plus CUDA-event GPU busy time and RDMA
# completion-wait time under query_breakdown.utilization.
ENABLE_BREAKDOWN=1
OBSERVE_DEVICE_UTILIZATION=1

STORAGE_OWNER_UPDATE_MODE=exact
MIN_RECALL="${MIN_RECALL:--1}"
