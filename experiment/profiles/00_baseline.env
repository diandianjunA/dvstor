# Baseline: disaggregated exact Vamana without the three paper contributions.
# This profile keeps compute-side updates and does not enable GPUDirect,
# batched graph traversal, ALDI, or VCPI/RaBitQ.
PROFILE_NAME=00_baseline
CONTRIBUTION_STAGE=baseline

GPUDIRECT_RDMA=0
INSERT_EXECUTION=compute
EXPANSION_BATCH="${EXPANSION_BATCH:-1}"
RDMA_QP_POOL_SIZE="${RDMA_QP_POOL_SIZE:-1}"
RDMA_READ_BATCH_MODE="${RDMA_READ_BATCH_MODE:-legacy}"
RDMA_READ_CHAIN_SIZE="${RDMA_READ_CHAIN_SIZE:-1}"
RDMA_READ_MAX_INFLIGHT_WRS="${RDMA_READ_MAX_INFLIGHT_WRS:-1}"
QUERY_BATCH_SIZE="${QUERY_BATCH_SIZE:-1}"
USE_RABITQ=0

# Keep ablation runs from aborting on recall drift; set MIN_RECALL=0.8810
# when running a strict publication-quality pass.
MIN_RECALL="${MIN_RECALL:--1}"
