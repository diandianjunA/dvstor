# Baseline: exact disaggregated Vamana on the common storage-owner substrate.
# Storage-owner exact update is treated as engineering substrate rather than a
# paper contribution. The baseline does not enable GPUDirect, K-way expansion,
# RaBitQ, ALDI, METIS locality, or adaptive multi-QP RDMA scheduling.
PROFILE_NAME=00_baseline
CONTRIBUTION_STAGE=baseline

GPUDIRECT_RDMA=0
INSERT_EXECUTION=storage_owner
EXPANSION_BATCH="${EXPANSION_BATCH:-1}"
RDMA_QP_POOL_SIZE="${RDMA_QP_POOL_SIZE:-1}"
RDMA_READ_BATCH_MODE="${RDMA_READ_BATCH_MODE:-legacy}"
RDMA_READ_CHAIN_SIZE="${RDMA_READ_CHAIN_SIZE:-0}"
RDMA_READ_MAX_INFLIGHT_WRS="${RDMA_READ_MAX_INFLIGHT_WRS:-0}"
QUERY_BATCH_SIZE="${QUERY_BATCH_SIZE:-1}"
USE_RABITQ=0
STORAGE_OWNER_UPDATE_MODE=exact

# Keep ablation runs from aborting on recall drift; set MIN_RECALL=0.8810
# when running a strict publication-quality pass.
MIN_RECALL="${MIN_RECALL:--1}"
