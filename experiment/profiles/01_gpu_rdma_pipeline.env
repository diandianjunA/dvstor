# Contribution 1: GPU-RDMA batched graph traversal pipeline.
# Isolates the query execution engine: GPUDirect vector reads, K-way expansion,
# adaptive RDMA batching, and GPU exact distance batches. Updates remain the
# baseline compute-side exact path.
PROFILE_NAME=01_gpu_rdma_pipeline
CONTRIBUTION_STAGE=gpu_rdma_pipeline

GPUDIRECT_RDMA=1
INSERT_EXECUTION=compute
EXPANSION_BATCH="${EXPANSION_BATCH:-4}"
RDMA_QP_POOL_SIZE="${RDMA_QP_POOL_SIZE:-0}"
RDMA_READ_BATCH_MODE="${RDMA_READ_BATCH_MODE:-adaptive}"
RDMA_READ_CHAIN_SIZE="${RDMA_READ_CHAIN_SIZE:-0}"
RDMA_READ_MAX_INFLIGHT_WRS="${RDMA_READ_MAX_INFLIGHT_WRS:-0}"
QUERY_BATCH_SIZE="${QUERY_BATCH_SIZE:-1}"
USE_RABITQ=0

MIN_RECALL="${MIN_RECALL:--1}"

