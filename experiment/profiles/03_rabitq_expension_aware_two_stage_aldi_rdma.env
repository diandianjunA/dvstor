# Contribution 1 + Contribution 2 + Contribution 3 + two-stage ALDI.
# Keeps foreground storage-owner inserts local-stitch and fast, while a storage-node
# background worker repairs graph quality under a fixed CPU-time budget.
PROFILE_NAME=03_rabitq_expension_aware_two_stage_aldi_rdma
CONTRIBUTION_STAGE=rabitq_expension_aware_two_stage_aldi_rdma

GPUDIRECT_RDMA=1
INSERT_EXECUTION=storage_owner
EXPANSION_BATCH="${EXPANSION_BATCH:-8}"
RDMA_QP_POOL_SIZE="${RDMA_QP_POOL_SIZE:-0}"
RDMA_READ_BATCH_MODE="${RDMA_READ_BATCH_MODE:-adaptive}"
RDMA_READ_CHAIN_SIZE="${RDMA_READ_CHAIN_SIZE:-0}"
RDMA_READ_MAX_INFLIGHT_WRS="${RDMA_READ_MAX_INFLIGHT_WRS:-0}"
QUERY_BATCH_SIZE="${QUERY_BATCH_SIZE:-1}"

CREDIT_AWARE_EXPANSION=1
CREDIT_AWARE_MIN_K="${CREDIT_AWARE_MIN_K:-$(( EXPANSION_BATCH < 4 ? EXPANSION_BATCH : 4 ))}"
CREDIT_AWARE_MAX_K="${CREDIT_AWARE_MAX_K:-$EXPANSION_BATCH}"
CREDIT_AWARE_TARGET_CANDIDATES="${CREDIT_AWARE_TARGET_CANDIDATES:-256}"
CREDIT_AWARE_MAX_LOOKAHEAD="${CREDIT_AWARE_MAX_LOOKAHEAD:-4}"
CREDIT_AWARE_COST_GUARD="${CREDIT_AWARE_COST_GUARD:-1}"
CREDIT_AWARE_COST_MAX_EXTRA_RATIO="${CREDIT_AWARE_COST_MAX_EXTRA_RATIO:-1.04}"
CREDIT_AWARE_COST_PROBE_ROUNDS="${CREDIT_AWARE_COST_PROBE_ROUNDS:-4}"

USE_RABITQ=1
RABITQ_GATE_WIDTH="${RABITQ_GATE_WIDTH:-18}"
RABITQ_GATE_MAX_WIDTH="${RABITQ_GATE_MAX_WIDTH:-36}"
RABITQ_GATE_MARGIN="${RABITQ_GATE_MARGIN:-0.08}"
RABITQ_CACHE_MAX_RATIO="${RABITQ_CACHE_MAX_RATIO:-0.10}"
RABITQ_DYNAMIC_BUDGET_MB="${RABITQ_DYNAMIC_BUDGET_MB:-64}"
RABITQ_COALESCE_TARGET="${RABITQ_COALESCE_TARGET:-64}"
RABITQ_COALESCE_MIN="${RABITQ_COALESCE_MIN:-32}"
RABITQ_COALESCE_WAIT_US="${RABITQ_COALESCE_WAIT_US:-6}"
RABITQ_WARMUP_EXACT_EXPANSIONS="${RABITQ_WARMUP_EXACT_EXPANSIONS:-6}"
RABITQ_AUDIT_PERIOD="${RABITQ_AUDIT_PERIOD:-12}"
RABITQ_STRICT_RECALL="${RABITQ_STRICT_RECALL:-1}"

STORAGE_OWNER_UPDATE_MODE="${STORAGE_OWNER_UPDATE_MODE:-local_stitch}"
STORAGE_OWNER_ANCHOR_HINTS="${STORAGE_OWNER_ANCHOR_HINTS:-4}"
STORAGE_OWNER_ANCHOR_BEAM_WIDTH="${STORAGE_OWNER_ANCHOR_BEAM_WIDTH:-64}"
STORAGE_OWNER_ANCHOR_EXPAND_CAP="${STORAGE_OWNER_ANCHOR_EXPAND_CAP:-16}"
STORAGE_OWNER_ANCHOR_REMOTE_RESCUE_CAP="${STORAGE_OWNER_ANCHOR_REMOTE_RESCUE_CAP:-4}"
STORAGE_OWNER_LOCAL_STITCH_SYNC_FAST_PATH="${STORAGE_OWNER_LOCAL_STITCH_SYNC_FAST_PATH:-1}"

STORAGE_OWNER_MAINTENANCE_MODE="${STORAGE_OWNER_MAINTENANCE_MODE:-finalize}"
STORAGE_OWNER_MAINTENANCE_WORKERS="${STORAGE_OWNER_MAINTENANCE_WORKERS:-8}"

PARTITION_STRATEGY=metis
INDEX_PREFIX="${METIS_INDEX_PREFIX:-$INDEX_DIR/sift100m_R${R}_bw${BUILD_BEAM}_metis_pmd32}"

MIN_RECALL="${MIN_RECALL:--1}"
ENABLE_BREAKDOWN=1
OBSERVE_DEVICE_UTILIZATION=0
