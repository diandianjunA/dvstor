# Motivation experiment: make the per-query serial RDMA/GPU dependency visible.
# This is an instrumented, query-only profile; it is not for final QPS or p95
# numbers.  One query worker and one coroutine ensure that no cross-query work
# hides the remote wait of strict best-first traversal.
PROFILE_NAME=motivation_serial_pipeline
CONTRIBUTION_STAGE=motivation_serial_pipeline

WORKLOAD=query
CLIENT_THREADS=1
SERVICE_THREADS=1
COROUTINES=1
QUERY_WORKERS=1
QUERY_COROUTINES=1
INSERT_WORKERS=0
INSERT_COROUTINES=0

GPUDIRECT_RDMA=1
INSERT_EXECUTION=storage_owner
EXPANSION_BATCH=1
QUERY_BATCH_SIZE=1
RDMA_QP_POOL_SIZE=1
RDMA_READ_BATCH_MODE=legacy
RDMA_READ_CHAIN_SIZE=0
RDMA_READ_MAX_INFLIGHT_WRS=0
USE_RABITQ=0

# Emit per-request phase breakdown plus CUDA-event GPU busy time and RDMA
# completion-wait time under query_breakdown.utilization.
ENABLE_BREAKDOWN=1
OBSERVE_DEVICE_UTILIZATION=1

STORAGE_OWNER_UPDATE_MODE=exact
MIN_RECALL="${MIN_RECALL:--1}"
