# Contribution 1 + Contribution 2.
# Adds communication-bounded ALDI updates and the METIS/locality-oriented
# partition. RDMA scheduling remains legacy single-QP so the locality-induced
# loss of cross-node RDMA parallelism can be observed before Contribution 3.
PROFILE_NAME=02_rabitq_gpu_pipeline_aldi
CONTRIBUTION_STAGE=rabitq_gpu_pipeline_aldi

GPUDIRECT_RDMA=1
INSERT_EXECUTION=storage_owner
EXPANSION_BATCH="${EXPANSION_BATCH:-4}"
RDMA_QP_POOL_SIZE="${RDMA_QP_POOL_SIZE:-1}"
RDMA_READ_BATCH_MODE="${RDMA_READ_BATCH_MODE:-legacy}"
RDMA_READ_CHAIN_SIZE="${RDMA_READ_CHAIN_SIZE:-0}"
RDMA_READ_MAX_INFLIGHT_WRS="${RDMA_READ_MAX_INFLIGHT_WRS:-0}"
QUERY_BATCH_SIZE="${QUERY_BATCH_SIZE:-1}"

USE_RABITQ=1
RABITQ_MODE="${RABITQ_MODE:-cpu_gate}"
RABITQ_GATE_WIDTH="${RABITQ_GATE_WIDTH:-18}"
RABITQ_GATE_MAX_WIDTH="${RABITQ_GATE_MAX_WIDTH:-36}"
RABITQ_GATE_MARGIN="${RABITQ_GATE_MARGIN:-0.08}"
RABITQ_CACHE_MAX_RATIO="${RABITQ_CACHE_MAX_RATIO:-0.10}"
RABITQ_DYNAMIC_BUDGET_MB="${RABITQ_DYNAMIC_BUDGET_MB:-64}"
RABITQ_COALESCE_TARGET="${RABITQ_COALESCE_TARGET:-64}"
RABITQ_COALESCE_MIN="${RABITQ_COALESCE_MIN:-32}"
RABITQ_COALESCE_WAIT_US="${RABITQ_COALESCE_WAIT_US:-6}"
RABITQ_PREFETCH_WIDTH="${RABITQ_PREFETCH_WIDTH:-2}"
RABITQ_PREFETCH_MIN_SAMPLES="${RABITQ_PREFETCH_MIN_SAMPLES:-16}"
RABITQ_PREFETCH_MIN_HIT_RATIO="${RABITQ_PREFETCH_MIN_HIT_RATIO:-0.35}"
RABITQ_WARMUP_EXACT_EXPANSIONS="${RABITQ_WARMUP_EXACT_EXPANSIONS:-6}"
RABITQ_AUDIT_PERIOD="${RABITQ_AUDIT_PERIOD:-12}"
RABITQ_SAFE_EPSILON="${RABITQ_SAFE_EPSILON:-0.0001}"
RABITQ_STRICT_RECALL="${RABITQ_STRICT_RECALL:-1}"

STORAGE_OWNER_UPDATE_MODE=anchored
STORAGE_OWNER_ANCHOR_HINTS="${STORAGE_OWNER_ANCHOR_HINTS:-4}"
STORAGE_OWNER_ANCHOR_BEAM_WIDTH="${STORAGE_OWNER_ANCHOR_BEAM_WIDTH:-64}"
STORAGE_OWNER_ANCHOR_EXPAND_CAP="${STORAGE_OWNER_ANCHOR_EXPAND_CAP:-16}"
STORAGE_OWNER_ANCHOR_REMOTE_RESCUE_CAP="${STORAGE_OWNER_ANCHOR_REMOTE_RESCUE_CAP:-4}"
STORAGE_OWNER_ANCHOR_AUDIT_RATE="${STORAGE_OWNER_ANCHOR_AUDIT_RATE:-256}"
STORAGE_OWNER_ANCHOR_MIN_OVERLAP="${STORAGE_OWNER_ANCHOR_MIN_OVERLAP:-0.5}"

PARTITION_STRATEGY=metis
INDEX_PREFIX="${METIS_INDEX_PREFIX:-$INDEX_DIR/sift100m_R${R}_bw${BUILD_BEAM}_metis}"

# PARTITION_STRATEGY=bfs
# INDEX_PREFIX="${BFS_INDEX_PREFIX:-$INDEX_DIR/sift100m_R${R}_bw${BUILD_BEAM}_bfs}"

MIN_RECALL="${MIN_RECALL:--1}"

