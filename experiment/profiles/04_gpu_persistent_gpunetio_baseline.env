# Architecture baseline: disaggregated storage, persistent GPU/GPUNetIO, and
# the two-stage update-offload protocol, with optional performance features off.

source "$EXPERIMENT_DIR/profiles/04_gpu_persistent_gpunetio_common.sh"

GPU_GRAPH_ISSUE_WIDTH="${GPU_GRAPH_ISSUE_WIDTH:-16}"
GPU_QUERY_BEAM_MERGE_POLICY="${GPU_QUERY_BEAM_MERGE_POLICY:-legacy}"
GPU_QUERY_GRAPH_READ_POLICY="${GPU_QUERY_GRAPH_READ_POLICY:-fixed}"
GPU_DYNAMIC_GRAPH_EXTENT="${GPU_DYNAMIC_GRAPH_EXTENT:-false}"

STORAGE_OWNER_STAGE2_SCORE_MANY="${STORAGE_OWNER_STAGE2_SCORE_MANY:-false}"
STORAGE_OWNER_STAGE2_GRAPH_ISSUE_WIDTH="${STORAGE_OWNER_STAGE2_GRAPH_ISSUE_WIDTH:-1}"
STORAGE_OWNER_STAGE2_HOME_RPC_COMBINING="${STORAGE_OWNER_STAGE2_HOME_RPC_COMBINING:-false}"
